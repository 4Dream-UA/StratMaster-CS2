# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# The same file shape serves both environments; only the values differ.
# Where they differ, the production value is noted.

# ===== DATABASE =====
POSTGRES_USER=stratmaster
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stratmaster_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Inside compose the app reaches Postgres by service name on its own port.
# (The dev compose additionally publishes it on localhost:5433 for the test
# suite; the production compose deliberately does not.)
DATABASE_URL=postgresql+asyncpg://stratmaster:changeme@db:5432/stratmaster_db

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ===== TELEGRAM BOT =====
# Production and staging MUST use different bots. One token polling from two
# places makes Telegram hand each update to whichever instance asked first,
# so half of a real player's messages would land on the test server.
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_SECRET=your_webhook_secret_here
# The Mini App origin. Production: https://stratmaster.fun
WEBAPP_URL=https://your-domain.com

# ===== CRYPTO PAYMENT =====
CRYPTOPAY_TOKEN=your_cryptopay_token_here
CRYPTOPAY_WEBHOOK_SECRET=your_cryptopay_webhook_secret_here

# ===== AI SUPPORT ASSISTANT =====
# Leave OPENAI_API_KEY blank to keep the assistant switched off entirely.
# Admins can also toggle it from the admin dashboard without a redeploy.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Sent to the API verbatim — must be a model id that endpoint serves.
AI_AGENT_MODEL=gpt-5.6-luna
AI_AGENT_MAX_REPLIES_PER_THREAD=3

# ===== NGROK (staging only) =====
# Not used by the app itself — only by the `ngrok` service in the dev
# compose file, which is how the staging server is reachable over HTTPS.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# ===== APP =====
# Production: False. DEBUG=True turns on SQLAlchemy echo, which logs every
# statement the app runs — unreadable logs and a real throughput cost.
DEBUG=True
# Production: generate one, e.g. `openssl rand -hex 32`.
SECRET_KEY=change_this_to_a_random_secret_key
# Production: production
ENVIRONMENT=development
