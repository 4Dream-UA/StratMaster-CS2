FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

# Production stage with Nginx
FROM nginx:1.25-alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Which nginx config to bake in. Defaults to the plain-HTTP dev/staging one
# (ngrok terminates TLS in front of it); docker-compose.prod.yml overrides
# this with frontend/nginx.prod.conf, which serves TLS itself.
ARG NGINX_CONF=frontend/nginx.conf
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]